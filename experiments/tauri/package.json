{
  "name": "snapzy-tauri-ui",
  "version": "0.15.0-alpha.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 51819 --strictPort",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node tests/ui-smoke.mjs",
    "test:editor-ui": "node tests/editor-ui-smoke.mjs",
    "test:editor-engine": "node tests/editor-engine-smoke.mjs",
    "prepare:engine": "node scripts/prepare-engine.mjs",
    "desktop:dev": "npm run prepare:engine && tauri dev",
    "desktop:build": "npm run prepare:engine && tauri build --bundles nsis && node scripts/package-trial.mjs"
  },
  "dependencies": {
    "lucide": "1.60.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3",
    "vite": "8.3.4",
    "playwright": "1.62.1"
  }
}
